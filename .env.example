# ==============================================================================
# Aura3D - Configuración de Variables de Entorno
# ==============================================================================
# Copia este archivo como '.env' para personalizar la configuración local.
# En Node.js 20.12+ / 24+ se carga automáticamente al iniciar el servidor.

# Puerto del Servidor Backend (Por defecto: 4000)
PORT=4000

# Entorno: development | production
NODE_ENV=development

# Clave secreta para firma de JSON Web Tokens (En desarrollo se genera una efímera si se omite)
# JWT_SECRET=tu_clave_secreta_super_segura_de_al_menos_32_caracteres

# URL base del cliente web
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Integración con Spotify Developer API (Spotify Connect / Web API)
# ------------------------------------------------------------------------------
# Para habilitar Spotify Connect:
# 1. Ve a https://developer.spotify.com/dashboard y crea una aplicación.
# 2. En la configuración de la app añade la Redirect URI:
#    http://127.0.0.1:4000/api/spotify/callback
# 3. Copia el Client ID y Client Secret abajo:
SPOTIFY_CLIENT_ID=85a0dbcfe5384518946c6b510999441a
SPOTIFY_CLIENT_SECRET=55a2d07459b54fb0a891dc9f54f34437
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4000/api/spotify/callback
